# =========================
# Django Core
# =========================
SECRET_KEY=replace-with-generated-django-secret-key
DEBUG=False
ALLOWED_HOSTS=your-service.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com

# =========================
# Deployment Security
# =========================
# Local development can keep these values disabled:
# DEBUG=True
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# SECURE_HSTS_SECONDS=0
#
# Production can enable these after HTTPS is confirmed:
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
ACCOUNT_LOGOUT_ON_GET=False

# =========================
# Database (Cloud MySQL)
# =========================
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_cloud_db_name
DB_USER=your_cloud_db_user
DB_PASSWORD=your_cloud_db_password
DB_HOST=your_cloud_db_host
DB_PORT=3306
DB_CONN_MAX_AGE=60

# =========================
# Local Database Fallback (Optional for local dev)
# =========================
LOCAL_DB_ENGINE=django.db.backends.mysql
LOCAL_DB_NAME=project_db
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=your_local_db_password
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3307
MYSQL_PASSWORD=your_local_db_password_legacy_fallback

# =========================
# Gemini / Chatbot
# =========================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# =========================
# Email SMTP
# =========================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=IBAYAW Tours <your_email@gmail.com>

# =========================
# Optional Billing URLs
# =========================
TOURISM_OFFICE_BILLING_URL=https://example.com/billing
TOURISM_TREASURER_BILLING_URL=https://example.com/treasurer-billing

# =========================
# Optional Security Keys
# =========================
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# =========================
# Social Login (Guest side)
# =========================
SITE_ID=1
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
FACEBOOK_OAUTH_APP_ID=your_facebook_app_id
FACEBOOK_OAUTH_APP_SECRET=your_facebook_app_secret
